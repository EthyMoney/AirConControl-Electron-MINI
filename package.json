{
  "name": "electron-ac-control",
  "version": "1.0.0",
  "description": "Electron kiosk controller for an MQTT-driven air conditioning display.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "render:plymouth": "electron --no-sandbox --headless --disable-gpu --ozone-platform=headless plymouth/render-assets.cjs",
    "lint": "node --check main.js && node --check renderer.js && node --check preload.js && node --check mqtt-controller.js && node --check home-assistant-bridge.js && node --check runtime-store.js && node --check config.js",
    "test": "node --test",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "start:desktop": "electron . --desktop",
    "package:win:desktop": "electron-builder --win --dir --config.extraMetadata.airconDesktopMode=true --config.directories.output=dist-desktop",
    "dist:win:desktop": "electron-builder --win --config.extraMetadata.airconDesktopMode=true --config.directories.output=dist-desktop"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  },
  "dependencies": {
    "mqtt": "^5.15.1"
  },
  "build": {
    "appId": "com.ethymoney.airconcontrol",
    "productName": "AirConControl",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "snow.ico",
      "package.json"
    ],
    "directories": {
      "buildResources": "."
    },
    "win": {
      "icon": "snow.ico"
    },
    "linux": {
      "category": "Utility"
    }
  }
}
